# Public URL that the Android device can reach. Use https:// for TLS tunnels.
CODEX_MOBILE_RELAY_URL=https://bridge.example.com/v1/ws

# Mac-side defaults. These values are examples, not credentials.
RELAY_HOST=127.0.0.1
RELAY_PORT=18880
RELAY_MAX_REPLAY=200
CODEX_PROJECT_ROOT=/Users/your-name
CODEX_MOBILE_FILE_ROOTS=/Users/your-name/Documents
